<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jc.aiagent.mapper.ChatMemoryMapper">
    <select id ="selectByChatId" resultType ="com.jc.aiagent.entity.ChatMemoryEntity">
        SELECT id, chat_id, content, type, `timeStamp`
        FROM chat_memory
        WHERE chat_id = #{chatId}
        ORDER BY `timeStamp` ASC
    </select>
    <insert id ="batchInsert">
        INSERT INTO chat_memory (chat_id, content,type,`timeStamp`)
        VALUES
        <foreach collection="list" item ="item" separator=",">
            (#{item.chatId},#{item.content},#{item.type},#{item.timeStamp})
        </foreach>
    </insert>
    <delete id = "deleteByChatId">
        DELETE FROM chat_memory WHERE chat_id = #{chatId}
    </delete>
</mapper>